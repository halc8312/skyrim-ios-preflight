diff --git a/runtime/x86.h b/runtime/x86.h
--- a/runtime/x86.h
+++ b/runtime/x86.h
@@ -24,6 +24,10 @@
     int32_t i[4];
     uint64_t q[2];
 } Xmm;
+
+/* Arithmetic flags are cached in generated function locals and synchronized
+ * through CPU at call/return boundaries. Undefined AF is not promised. */
+typedef struct { uint32_t cf, zf, sf, of, pf, af; } Flags;
 
 typedef struct CPU {
     uint32_t r[8];          /* eax ecx edx ebx esp ebp esi edi */
@@ -42,6 +46,7 @@
     uint64_t mm[8];
     /* host-side per-thread data */
     void *thread;
+    Flags flags;           /* appended: preserve existing CPU field offsets */
 } CPU;
 
 extern uint8_t *MEM;
@@ -58,11 +63,6 @@
 #define M64(a) (*(u64u *)(MEM + (uint32_t)(a)))
 #define MF32(a) (*(f32u *)(MEM + (uint32_t)(a)))
 #define MF64(a) (*(f64u *)(MEM + (uint32_t)(a)))
-
-/* AF is updated only where architecturally defined. Logic/shift/multiply
- * operations with undefined AF do not promise a value. Flags remain function
- * locals: the existing SPILL/RELOAD design does not preserve them across calls. */
-typedef struct { uint32_t cf, zf, sf, of, pf, af; } Flags;
 
 static inline uint32_t par8(uint32_t r) { return !__builtin_parity(r & 0xFF); }
 
diff --git a/runtime/lift_prelude.h b/runtime/lift_prelude.h
--- a/runtime/lift_prelude.h
+++ b/runtime/lift_prelude.h
@@ -7,9 +7,9 @@
 jmp_buf *rt_setjmp_slot(CPU *c, uint32_t guest_jb);
 void rt_setjmp3(CPU *c);
 #define SPILL() do { c->r[0] = eax; c->r[1] = ecx; c->r[2] = edx; c->r[3] = ebx; \
-    c->r[4] = esp; c->r[5] = ebp; c->r[6] = esi; c->r[7] = edi; } while (0)
+    c->r[4] = esp; c->r[5] = ebp; c->r[6] = esi; c->r[7] = edi; c->flags = f; } while (0)
 #define RELOAD() do { eax = c->r[0]; ecx = c->r[1]; edx = c->r[2]; ebx = c->r[3]; \
-    esp = c->r[4]; ebp = c->r[5]; esi = c->r[6]; edi = c->r[7]; } while (0)
+    esp = c->r[4]; ebp = c->r[5]; esi = c->r[6]; edi = c->r[7]; f = c->flags; } while (0)
 static inline void rt_movsd(uint32_t n, uint32_t dst, uint32_t src) {
     /* forward rep movsd; overlapping copies must behave like the dword loop */
     if (dst <= src || dst >= src + n * 4) memmove(MEM + dst, MEM + src, (size_t)n * 4);
