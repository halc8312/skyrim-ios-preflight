diff --git a/runtime/lift_prelude.h b/runtime/lift_prelude.h
index eb43d1f..2400040 100644
--- a/runtime/lift_prelude.h
+++ b/runtime/lift_prelude.h
@@ -78,15 +78,23 @@ static inline void rt_movsd(uint32_t n, uint32_t dst, uint32_t src) {
 #define TS16(a, v) (*(volatile u16u *)(MEM + (uint32_t)(a)) = (v))
 #define TS32(a, v) (*(volatile u32u *)(MEM + (uint32_t)(a)) = (v))
 #else
-static inline uint8_t TL8(uint32_t a) { return __atomic_load_n(MEM + a, __ATOMIC_ACQUIRE); }
-static inline void TS8(uint32_t a, uint8_t v) { __atomic_store_n(MEM + a, v, __ATOMIC_RELEASE); }
+/* The guest memory base is a parameter (patch 0010): a generated function binds `MEM` to a const local, so the
+ * compiler does not reload the global after every acquire/release access. Behaviour and ordering are unchanged. */
+static inline uint8_t TL8_(uint8_t *m, uint32_t a) { return __atomic_load_n(m + a, __ATOMIC_ACQUIRE); }
+static inline void TS8_(uint8_t *m, uint32_t a, uint8_t v) { __atomic_store_n(m + a, v, __ATOMIC_RELEASE); }
 #define TSO_PAIR(n, T, mask) \
-static inline T TL##n(uint32_t a) { \
-    if (__builtin_expect(!(a & mask), 1)) return __atomic_load_n((T *)(MEM + a), __ATOMIC_ACQUIRE); \
-    T v; memcpy(&v, MEM + a, sizeof v); __atomic_thread_fence(__ATOMIC_ACQUIRE); return v; } \
-static inline void TS##n(uint32_t a, T v) { \
-    if (__builtin_expect(!(a & mask), 1)) { __atomic_store_n((T *)(MEM + a), v, __ATOMIC_RELEASE); return; } \
-    __atomic_thread_fence(__ATOMIC_RELEASE); __builtin_memcpy(MEM + a, &v, sizeof v); }
+static inline T TL##n##_(uint8_t *m, uint32_t a) { \
+    if (__builtin_expect(!(a & mask), 1)) return __atomic_load_n((T *)(m + a), __ATOMIC_ACQUIRE); \
+    T v; __builtin_memcpy(&v, m + a, sizeof v); __atomic_thread_fence(__ATOMIC_ACQUIRE); return v; } \
+static inline void TS##n##_(uint8_t *m, uint32_t a, T v) { \
+    if (__builtin_expect(!(a & mask), 1)) { __atomic_store_n((T *)(m + a), v, __ATOMIC_RELEASE); return; } \
+    __atomic_thread_fence(__ATOMIC_RELEASE); __builtin_memcpy(m + a, &v, sizeof v); }
 TSO_PAIR(16, uint16_t, 1)
 TSO_PAIR(32, uint32_t, 3)
+#define TL8(a) TL8_(MEM, (uint32_t)(a))
+#define TL16(a) TL16_(MEM, (uint32_t)(a))
+#define TL32(a) TL32_(MEM, (uint32_t)(a))
+#define TS8(a, v) TS8_(MEM, (uint32_t)(a), (v))
+#define TS16(a, v) TS16_(MEM, (uint32_t)(a), (v))
+#define TS32(a, v) TS32_(MEM, (uint32_t)(a), (v))
 #endif
