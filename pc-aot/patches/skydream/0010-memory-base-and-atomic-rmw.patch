-        text += "".join("\n".join(good[fa][0]) + "\n\n" for fa in chunk)
+        text += "".join("\n".join(mem_local_pass("\n".join(good[fa][0]).split("\n"))) + "\n\n" for fa in chunk)
         write_if_changed(os.path.join(OUT, "%s_%02d.c" % (MOD, k)), text)
     text = '#include "funcs_%s.h"\n#include "rt_table.h"\nconst FnEntry g_fn_table_%s[] = {\n' % (MOD, MOD)
     text += "".join("    {0x%Xu, f_%X},\n" % (fa, fa) for fa in names)
@@ -1630,5 +1649,23 @@ def main():
     json.dump({hex(k): v for k, v in failed.items()}, open(os.path.join(OUT, "%s_rejected.json" % MOD), "w"), indent=0)
 
 
+# ---- Patch 0010: guest memory base in a const local (text pass over the finished functions) ----
+MEM_PROLOGUE = ["    uint8_t *const mem_ = MEM;", "#define MEM mem_"]
+
+
+def mem_local_pass(lines):
+    """Bind `MEM` to a const local for the whole function. The macro is only visible inside the function body, so
+    every M*/TL*/TS* access, memcpy and atomic of the emitted text uses the local, while helpers defined earlier
+    (and other translation units) keep the global. Anything that is not a plain generated function is left alone.
+    Runs on the finished text, after the flag and x87 analyses that read the emitted lines."""
+    if not MEMLOCAL:
+        return lines
+    if len(lines) < 3 or not lines[0].startswith("void f_") or not lines[0].endswith(" {") or lines[-1] != "}":
+        return lines
+    if "mem_" in "\n".join(lines):
+        raise RuntimeError("mem_ is already used in the generated text")
+    return [lines[0]] + MEM_PROLOGUE + lines[1:] + ["#undef MEM"]
+
+
 if __name__ == "__main__":
     main()
