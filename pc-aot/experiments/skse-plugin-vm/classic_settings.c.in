/* Included in plugin_trial.c so the scoped backend and the diagnostic share
 * the isolated interpreter, without exposing its internal session layout. */
#include "classic_settings.h"
#include "classic_pex.h"
#include "probe_asset_file.h"
#include "../../ios/runtime-port/classic_mod_layout.h"
#include "../skse-profile-json/profile_overlay.h"

#include <fcntl.h>
#include <sys/stat.h>
#include <unistd.h>
#if defined(__APPLE__)
#include <CommonCrypto/CommonDigest.h>
#else
#include <openssl/sha.h>
#endif

#define SETTINGS_ROOT "Data/SKSE/Plugins/WearableLanternsData"
enum { SETTINGS_DLL_BYTES = 978944, SETTINGS_PEX_BYTES = 8182, STORAGE_PEX_BYTES = 19558,
       SETTINGS_CALL_WORK = 500000, LANTERN_KEYWORD_LOCAL = 0x01d9a9, LANTERN_KEYWORD_TYPE = 4 };
static const uint8_t settings_executable_hash[32] = {
    0xd9, 0x7e, 0xb0, 0xcc, 0x0c, 0xee, 0xf0, 0x92,
    0x3d, 0x22, 0x34, 0xd4, 0x2b, 0x38, 0x2c, 0x0d,
    0x03, 0x38, 0x53, 0x35, 0x65, 0x28, 0xb2, 0x71,
    0xbc, 0x04, 0x35, 0x42, 0xb1, 0xf5, 0xe6, 0x05
};
static const uint8_t settings_dll_hash[32] = {
    0x51, 0xe4, 0x0d, 0x27, 0xbc, 0x63, 0x56, 0x64,
    0xd7, 0x47, 0xa7, 0x81, 0x17, 0x96, 0x73, 0xd9,
    0xcb, 0xda, 0x8c, 0x22, 0xd1, 0x76, 0xf5, 0x6f,
    0xa6, 0x59, 0x8f, 0xcc, 0xe4, 0xa0, 0xb5, 0xe9
};
static const uint8_t settings_pex_hash[32] = {
    0x00, 0xbb, 0xc3, 0xcf, 0x5a, 0x26, 0x89, 0xf0,
    0x07, 0xdc, 0x01, 0x0b, 0x05, 0xa8, 0xcd, 0xa8,
    0x46, 0x40, 0xcd, 0x5a, 0x0d, 0x03, 0xc5, 0x94,
    0x17, 0x81, 0xbf, 0x50, 0x64, 0xc9, 0x40, 0xd0
};
static const uint8_t storage_pex_hash[32] = {
    0xbd, 0xb7, 0xa7, 0xde, 0xbb, 0xbb, 0x46, 0x23,
    0x20, 0xec, 0xfb, 0x1c, 0x3f, 0x31, 0x7a, 0xb7,
    0x53, 0xa4, 0x88, 0xbc, 0xb5, 0xee, 0x1a, 0xe6,
    0x4f, 0x71, 0x45, 0xf4, 0x9d, 0x18, 0x55, 0x13
};
typedef struct {
    const char *name;
    uint32_t result, count;
    uint32_t arguments[4];
} SettingsSignature;
static const SettingsSignature settings_signatures[] = {
    [SKSE_SETTINGS_GET_INT] = {"GetIntValue", 3, 3, {2, 2, 3}},
    [SKSE_SETTINGS_GET_FLOAT] = {"GetFloatValue", 4, 3, {2, 2, 4}},
    [SKSE_SETTINGS_GET_STRING] = {"GetStringValue", 2, 3, {2, 2, 2}},
    [SKSE_SETTINGS_SET_INT] = {"SetIntValue", 3, 3, {2, 2, 3}},
    [SKSE_SETTINGS_SET_FLOAT] = {"SetFloatValue", 4, 3, {2, 2, 4}},
    [SKSE_SETTINGS_SET_STRING] = {"SetStringValue", 2, 3, {2, 2, 2}},
    [SKSE_SETTINGS_SAVE] = {"Save", 5, 2, {2, 5}},
    [SKSE_SETTINGS_LOAD] = {"Load", 5, 1, {2}},
    [SKSE_SETTINGS_INT_LIST_CLEAR] = {"IntListClear", 3, 2, {2, 2}},
    [SKSE_SETTINGS_INT_LIST_GET] = {"IntListGet", 3, 3, {2, 2, 3}},
    [SKSE_SETTINGS_INT_LIST_RESIZE] = {"IntListResize", 3, 4, {2, 2, 3, 3}},
    [SKSE_SETTINGS_INT_LIST_SET] = {"IntListSet", 3, 4, {2, 2, 3, 3}}
};
static const SettingsSignature storage_keyword_signatures[] = {
    [SKSE_STORAGE_KEYWORD_GET_INT] = {"GetIntValue", 3, 3, {SKSE_CLASSIC_CATALOG_FORM, 2, 3}},
    [SKSE_STORAGE_KEYWORD_SET_INT] = {"SetIntValue", 3, 3, {SKSE_CLASSIC_CATALOG_FORM, 2, 3}}
};

struct SkseClassicSettings {
    SksePluginSession session;
    SkseClassicCatalog catalog;
    const SkseClassicDeclaration *methods[SKSE_SETTINGS_METHOD_LIMIT];
    const SkseClassicDeclaration *storage_keyword[SKSE_STORAGE_KEYWORD_METHOD_LIMIT];
    uint32_t storage_keyword_id;
    SkseProfileJsonStore *store;
    SkseProfileJsonOverlay *overlay;
    SkseProfileJsonBatch batch;
    const SkseWinFileData *closed_output;
    uint8_t bootstrap[8];
    SkseX86ReadView bootstrap_views[2];
    uint64_t epoch, last_ticket, pending;
    int game_fd;
    bool retired;
};

void skse_classic_settings_scan_bootstrap(SkseSettingsBootstrap *snapshot, uint64_t offset,
                                         const void *buffer, size_t size) {
    if (!snapshot || !buffer || !size) return;
    /* The two file offsets are tied to settings_executable_hash. No
     * addresses from an unverified PE header are used during scanning. */
    static const uint32_t sources[] = {0x00e3f66c, 0x00eb3b80};
    const uint8_t *input = buffer;
    for (unsigned i = 0; i < sizeof snapshot->words; ++i) {
        const uint64_t wanted = sources[i / 4] + i % 4;
        if (wanted >= offset && wanted - offset < size) {
            snapshot->words[i] = input[wanted - offset];
            snapshot->seen |= (uint8_t)(1u << i);
        }
    }
}

bool skse_classic_settings_copy_bootstrap(const SkseSettingsBootstrap *snapshot, const uint8_t digest[32],
                                         uint8_t words[8]) {
    if (!snapshot || !digest || !words || snapshot->seen != UINT8_MAX ||
        memcmp(settings_executable_hash, digest, sizeof settings_executable_hash)) return false;
    memcpy(words, snapshot->words, sizeof snapshot->words);
    return true;
}

static bool settings_digest_matches(const uint8_t *bytes, size_t size, const uint8_t expected[32]) {
    uint8_t actual[32];
#if defined(__APPLE__)
    return CC_SHA256(bytes, (CC_LONG)size, actual) && memcmp(actual, expected, sizeof actual) == 0;
#else
    return SHA256(bytes, size, actual) && memcmp(actual, expected, sizeof actual) == 0;
#endif
}

static bool settings_asset_path(const char *path) {
    const size_t root_length = sizeof SETTINGS_ROOT - 1;
    if (strlen(path) <= root_length || path[root_length] != '/') return false;
    char root[sizeof SETTINGS_ROOT];
    memcpy(root, path, root_length);
    root[root_length] = 0;
    return skse_win_asset_name_equal(root, SETTINGS_ROOT);
}

static uint32_t settings_asset_read(void *context, const char *path, size_t limit, uint8_t **bytes, size_t *size) {
    if (!settings_asset_path(path)) {
        *bytes = NULL;
        *size = 0;
        return 2; /* ERROR_FILE_NOT_FOUND */
    }
    return skse_probe_asset_read_unique(context, path, limit, bytes, size);
}

static uint32_t settings_asset_attributes(void *context, const char *path, uint32_t *attributes) {
    static const char *const virtual_directories[] = {
        "Data", "Data/SKSE", "Data/SKSE/Plugins", "Data/SKSE/Plugins/StorageUtilData", SETTINGS_ROOT
    };
    for (size_t i = 0; i < sizeof virtual_directories / sizeof virtual_directories[0]; ++i) {
        if (!skse_win_asset_name_equal(path, virtual_directories[i])) continue;
        *attributes = SKSE_WIN_ATTRIBUTE_DIRECTORY;
        return 0;
    }
    return settings_asset_path(path) ? skse_probe_asset_attributes(context, path, attributes) : 2;
}

/* Accept one relative filename directly beneath the authorized directory. */
static bool settings_target(const SkseClassicScalar *input, char path[SKSE_WIN_PATH_UNITS]) {
    static const char prefix[] = "../WearableLanternsData/";
    const size_t offset = sizeof prefix - 1;
    const size_t capacity = SKSE_WIN_PATH_UNITS - sizeof SETTINGS_ROOT - sizeof ".json";
    if (input->type != 2 || !input->text || input->text_size <= sizeof prefix ||
        input->text_size - sizeof prefix > capacity || memcmp(input->text, prefix, offset) ||
        input->text[input->text_size - 1] != 0) return false;
    const size_t length = input->text_size - sizeof prefix;
    for (size_t i = 0; i < length; ++i) {
        const unsigned c = skse_win_ascii_lower((uint8_t)input->text[offset + i]);
        if (!((c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '_' || c == '-')) return false;
    }
    memcpy(path, SETTINGS_ROOT "/", sizeof SETTINGS_ROOT);
    memcpy(path + sizeof SETTINGS_ROOT, input->text + offset, length);
    memcpy(path + sizeof SETTINGS_ROOT + length, ".json", sizeof ".json");
    return true;
}

static SkseSettingsStatus settings_check_signatures(const SkseClassicCatalog *catalog, const uint8_t *pex,
    size_t pex_size, const char *script, const SettingsSignature *signatures, size_t first, size_t limit,
    const SkseClassicDeclaration **methods) {
    SksePexNative *natives = calloc(SKSE_PEX_MAX_ROWS, sizeof *natives);
    if (!natives) return SKSE_SETTINGS_MEMORY;
    SksePexInventory inventory = {.natives = natives, .native_capacity = SKSE_PEX_MAX_ROWS};
    SkseSettingsStatus status = skse_pex_inspect(pex, pex_size, &inventory) == SKSE_PEX_OK
        ? SKSE_SETTINGS_OK : SKSE_SETTINGS_SIGNATURE;
    for (size_t method = first; status == SKSE_SETTINGS_OK && method < limit; ++method) {
        const SettingsSignature *signature = &signatures[method];
        const char *name = signature->name;
        const SksePexStaticCall call = {
            .script = {(const uint8_t *)script, (uint16_t)strlen(script)},
            .name = {(const uint8_t *)name, (uint16_t)strlen(name)}, .count = (uint16_t)signature->count
        };
        const SkseClassicDeclaration *row = NULL;
        if (skse_pex_match_call(&call, natives, inventory.native_count, catalog, &row) != SKSE_PEX_MATCH ||
            !row || row->owner || !row->is_static || row->result != signature->result ||
            row->count != call.count || memcmp(row->arguments, signature->arguments,
                                             call.count * sizeof row->arguments[0])) {
            status = SKSE_SETTINGS_SIGNATURE;
            break;
        }
        methods[method] = row;
    }
    free(natives);
    return status;
}

static SkseSettingsStatus settings_start(SkseClassicSettings *settings, const SkseSettingsInputs *inputs) {
    SksePluginSession *session = &settings->session;
    /* These inputs describe only the exact, pinned LE/PapyrusUtil pair. The
     * listed game sites are observed in virtual Load and never mapped as
     * game memory. The Windows fallback stops on unimplemented calls. */
    static const uint32_t sites[] = {0x006a9e90, 0x008cab54, 0x006f02ff};
    const SkseTrialOptions options = {
        .skse_version = 0x01070030, .runtime_version = 0x09200000, .release = 48, .plugin_handle = 1,
        .expose_release = 1, .expose_handle = 1
    };
    const SkseTrialRuntime runtime = {
        .uptime_ms = inputs->uptime_ms, .static_tls = 1, .serialization = 1, .module_file_name = "StorageUtil.dll",
        .read_views = settings->bootstrap_views, .read_view_count = 2, .capture_papyrus_startup = true,
        .trace_known_windows_imports = true, .hook_probe_sites = sites, .hook_probe_count = sizeof sites / sizeof sites[0],
        .assets = {settings_asset_read, settings_asset_attributes, &settings->game_fd}
    };
    const SkseTrialDependency source = {runtime.module_file_name, inputs->dll, inputs->dll_size};
    initialize_session(session, source, options, &runtime, NULL, 0, NO_CATALOG);
    if (is_traceable_import(&session->result, false)) {
        destroy_session_state(session);
        *session = (SksePluginSession){.trace_windows_imports = true};
        initialize_session(session, source, options, &runtime, NULL, 0, NO_CATALOG);
    }
    if (session->result.status != SKSE_TRIAL_ENGINE_HOOKS_OBSERVED ||
        session->result.load.hook_count != runtime.hook_probe_count) return SKSE_SETTINGS_STARTUP;

    if (!capture_classic_registry(session, &settings->catalog, NULL)) return SKSE_SETTINGS_SIGNATURE;
    return settings_check_signatures(&settings->catalog, inputs->pex, inputs->pex_size, "JsonUtil",
        settings_signatures, SKSE_SETTINGS_GET_INT, SKSE_SETTINGS_METHOD_LIMIT, settings->methods);
}

SkseSettingsStatus skse_classic_settings_open(const SkseSettingsInputs *inputs, SkseClassicSettings **out) {
    if (!out) return SKSE_SETTINGS_ARGUMENT;
    *out = NULL;
    static const uint8_t no_profile[16] = {0};
    if (!inputs || !inputs->epoch || !inputs->dll || !inputs->pex || inputs->game_fd < 0 || inputs->settings_fd < 0 ||
        !memcmp(inputs->profile, no_profile, sizeof no_profile))
        return SKSE_SETTINGS_ARGUMENT;
    if (inputs->dll_size != SETTINGS_DLL_BYTES || inputs->pex_size != SETTINGS_PEX_BYTES ||
        !settings_digest_matches(inputs->dll, inputs->dll_size, settings_dll_hash) ||
        !settings_digest_matches(inputs->pex, inputs->pex_size, settings_pex_hash)) return SKSE_SETTINGS_VERSION;
    struct stat game_info, store_info;
    if (fstat(inputs->game_fd, &game_info) || fstat(inputs->settings_fd, &store_info) ||
        !S_ISDIR(game_info.st_mode) || !S_ISDIR(store_info.st_mode) ||
        (game_info.st_dev == store_info.st_dev && game_info.st_ino == store_info.st_ino))
        return SKSE_SETTINGS_STORAGE;

    SkseClassicSettings *settings = calloc(1, sizeof *settings);
    if (!settings) return SKSE_SETTINGS_MEMORY;
    settings->epoch = inputs->epoch;
    settings->game_fd = openat(inputs->game_fd, ".", O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC);
    memcpy(settings->bootstrap, inputs->bootstrap, sizeof settings->bootstrap);
    settings->bootstrap_views[0] = (SkseX86ReadView){0x0124166c, settings->bootstrap, 4};
    settings->bootstrap_views[1] = (SkseX86ReadView){0x012b5b80, settings->bootstrap + 4, 4};
    const uint32_t limit = SKSE_CLASSIC_CATALOG_MAX_ROWS;
    settings->catalog = (SkseClassicCatalog){.limit = limit, .rows = calloc(limit, sizeof *settings->catalog.rows)};
    SkseProfileJsonGrant grant = {
        .virtual_prefix = SETTINGS_ROOT, .file_bytes = SKSE_PROFILE_JSON_MAX_FILE,
        .total_bytes = SKSE_PROFILE_JSON_MAX_TOTAL, .files = SKSE_PROFILE_JSON_MAX_FILES
    };
    memcpy(grant.identity.profile, inputs->profile, sizeof grant.identity.profile);
    memcpy(grant.identity.owner, settings_dll_hash, sizeof grant.identity.owner);

    SkseSettingsStatus status;
    if (!settings->catalog.rows) status = SKSE_SETTINGS_MEMORY;
    else if (settings->game_fd < 0 || skse_profile_json_open(inputs->settings_fd, &grant, &settings->store) ||
             skse_profile_json_overlay_open(settings->store, &grant.identity, &settings->overlay))
        status = SKSE_SETTINGS_STORAGE;
    else status = settings_start(settings, inputs);
    if (status != SKSE_SETTINGS_OK) {
        skse_classic_settings_close(settings);
        return status;
    }
    settings->session.files.profile = skse_profile_json_overlay_provider(settings->overlay);
    settings->session.files.read_only = true;
    if (!skse_win_profile_begin_call(&settings->session.files)) {
        skse_classic_settings_close(settings);
        return SKSE_SETTINGS_STORAGE;
    }
    *out = settings;
    return SKSE_SETTINGS_OK;
}

void skse_classic_settings_close(SkseClassicSettings *settings) {
    if (!settings) return;
    SksePluginSession *session = &settings->session;
    session->files.read_only = true;
    session->vm.remaining_work = TRIAL_BUDGET;
    destroy_session_state(session);
    skse_profile_json_batch_discard(&settings->batch);
    skse_profile_json_overlay_close(settings->overlay);
    skse_profile_json_close(settings->store);
    if (settings->game_fd >= 0) close(settings->game_fd);
    free(settings->catalog.rows);
    free(settings);
}

static SkseSettingsStatus settings_retire(SkseClassicSettings *settings, SkseSettingsStatus status) {
    settings->retired = true;
    settings->session.files.profile_aborted = true;
    skse_profile_json_batch_discard(&settings->batch);
    settings->closed_output = NULL;
    settings->pending = 0;
    return status;
}

static SkseSettingsStatus settings_execute(SkseClassicSettings *settings, const SkseClassicDeclaration *method,
    const SkseClassicScalar *arguments, size_t count, uint32_t uptime_ms, bool preparing, const char *save_target,
    const SkseClassicFormSnapshot *first_form,
    SkseClassicScalarResult *output, uint64_t *ticket, SkseX86Result *trace) {
    if (settings->retired) return SKSE_SETTINGS_RETIRED;
    if (!preparing && settings->last_ticket == UINT64_MAX) return settings_retire(settings, SKSE_SETTINGS_RETIRED);

    SksePluginSession *session = &settings->session;
    if (save_target) {
        uint32_t attributes;
        uint32_t found = settings_asset_attributes(&settings->game_fd, save_target, &attributes);
        if (found != 2 && found != 3) return SKSE_SETTINGS_STORAGE;
    }
    session->files.read_only = save_target == NULL;
    const uint32_t budget = preparing ? SKSE_CLASSIC_PREPARE_MAX_WORK : SETTINGS_CALL_WORK;
    const SkseClassicScalarScope scope = {
        .catalog = &settings->catalog, .prepare_method = preparing ? method : NULL,
        .images = session->vm.images, .image_count = session->vm.count, .scratch = session->vm.scratch,
        .services = &session->vm.services, .epoch = settings->catalog.epoch, .stack_id = PAPYRUS_FIXTURE_STACK_ID,
        .arguments_base = 0x1400c000, .text_base = 0x1400a000, .first_form = first_form
    };
    session_begin_work(session, budget, uptime_ms);
    SkseClassicScalarResult value;
    const SkseClassicScalarStatus ran = skse_classic_scalar_call(&scope, method, arguments,
        count, budget, preparing, &value, trace);
    session->files.read_only = true;
    if (ran == SKSE_SCALAR_ARGUMENT) return SKSE_SETTINGS_ARGUMENT;
    if (ran != SKSE_SCALAR_OK) return settings_retire(settings, SKSE_SETTINGS_EXECUTION);
    if (!skse_win_profile_begin_call(&session->files)) return settings_retire(settings, SKSE_SETTINGS_STORAGE);

    SkseWinProfileOutputs closed;
    if (skse_win_profile_closed_outputs(&session->files, true, &closed) || closed.count > 1 ||
        (closed.count && (!save_target || !value.bits ||
                          !skse_win_asset_name_equal(save_target, closed.entries[0]->path))))
        return settings_retire(settings, SKSE_SETTINGS_STORAGE);
    if (closed.count) {
        const SkseProfileJsonCaptureResult result = skse_profile_json_overlay_capture(settings->overlay,
            &session->files, true, &settings->batch);
        if (result.guest_error || result.storage_error || settings->batch.count != 1)
            return settings_retire(settings, SKSE_SETTINGS_STORAGE);
        settings->closed_output = closed.entries[0];
    }

    *output = value;
    if (!preparing) {
        settings->pending = ++settings->last_ticket;
        *ticket = settings->pending;
    }
    return SKSE_SETTINGS_OK;
}

static SkseSettingsStatus settings_call(SkseClassicSettings *settings, uint64_t epoch, SkseSettingsMethod method,
    const SkseClassicScalar *arguments, size_t count, uint32_t uptime_ms, bool preparing,
    SkseClassicScalarResult *output, uint64_t *ticket, SkseX86Result *trace) {
    if (trace) *trace = (SkseX86Result){.status = SKSE_X86_BAD_ARGUMENT};
    char target[SKSE_WIN_PATH_UNITS];
    if (!settings || settings->epoch != epoch || method < SKSE_SETTINGS_GET_INT || method >= SKSE_SETTINGS_METHOD_LIMIT ||
        !arguments || !output || (!preparing && !ticket) || count != settings_signatures[method].count ||
        settings->pending || !settings_target(arguments, target)) return SKSE_SETTINGS_ARGUMENT;
    return settings_execute(settings, settings->methods[method], arguments, count, uptime_ms, preparing,
        method == SKSE_SETTINGS_SAVE ? target : NULL, NULL, output, ticket, trace);
}

SkseSettingsStatus skse_classic_settings_prepare(SkseClassicSettings *settings, uint64_t epoch,
    const SkseClassicScalar arguments[3], uint32_t uptime_ms, SkseClassicScalarResult *output, SkseX86Result *trace) {
    /* The larger budget belongs to preparation before the first VM request. */
    if (!settings || settings->last_ticket) return SKSE_SETTINGS_ARGUMENT;
    return settings_call(settings, epoch, SKSE_SETTINGS_GET_INT, arguments, 3, uptime_ms, true, output, NULL, trace);
}

SkseSettingsStatus skse_classic_settings_invoke(SkseClassicSettings *settings, uint64_t epoch, SkseSettingsMethod method,
    const SkseClassicScalar *arguments, size_t count, uint32_t uptime_ms, SkseClassicScalarResult *output,
    uint64_t *ticket, SkseX86Result *trace) {
    return settings_call(settings, epoch, method, arguments, count, uptime_ms, false, output, ticket, trace);
}

SkseSettingsStatus skse_classic_settings_commit(SkseClassicSettings *settings, uint64_t epoch, uint64_t ticket) {
    if (!settings || settings->epoch != epoch || !ticket || settings->pending != ticket) return SKSE_SETTINGS_ARGUMENT;
    if (settings->batch.count) {
        if (!skse_win_profile_release_closed(&settings->session.files, settings->closed_output))
            return settings_retire(settings, SKSE_SETTINGS_STORAGE);
        const SkseProfileJsonResult saved = skse_profile_json_publish(settings->store, settings->batch.entries[0]);
        if (saved == SKSE_PROFILE_JSON_PUBLISHED_UNSYNCED)
            return settings_retire(settings, SKSE_SETTINGS_PUBLISHED_UNSYNCED);
        if (saved) return settings_retire(settings, SKSE_SETTINGS_STORAGE);
        skse_profile_json_batch_discard(&settings->batch);
        settings->closed_output = NULL;
    }
    settings->pending = 0;
    return SKSE_SETTINGS_OK;
}

void skse_classic_settings_discard(SkseClassicSettings *settings, uint64_t epoch, uint64_t ticket) {
    if (settings && settings->epoch == epoch && ticket && settings->pending == ticket)
        settings_retire(settings, SKSE_SETTINGS_RETIRED);
}

static bool lantern_owner(const SkseLoadedMod *owner) {
    static const uint8_t name[] = "Chesko_WearableLantern.esp";
    return owner && owner->kind == SKSE_LOADED_CLASSIC && owner->index && owner->index < SKSE_CLASSIC_MOD_LIMIT &&
           owner->name && owner->length == sizeof name - 1 &&
           !skse_classic_mod_name_compare(owner->name, owner->length, name, sizeof name - 1);
}

SkseSettingsStatus skse_classic_storage_enable_keyword(SkseClassicSettings *settings, uint64_t epoch,
    const uint8_t *storage_pex, size_t pex_size, const SkseLoadedMod *owner) {
    if (!settings || settings->epoch != epoch || settings->pending || !storage_pex || !lantern_owner(owner))
        return SKSE_SETTINGS_ARGUMENT;
    if (settings->retired) return SKSE_SETTINGS_RETIRED;
    uint32_t form_id = (uint32_t)owner->index << 24 | LANTERN_KEYWORD_LOCAL;
    if (settings->storage_keyword_id && settings->storage_keyword_id != form_id) return SKSE_SETTINGS_ARGUMENT;
    if (pex_size != STORAGE_PEX_BYTES || !settings_digest_matches(storage_pex, pex_size, storage_pex_hash))
        return SKSE_SETTINGS_VERSION;
    if (settings->storage_keyword_id) return SKSE_SETTINGS_OK;
    const SkseClassicDeclaration *methods[SKSE_STORAGE_KEYWORD_METHOD_LIMIT];
    SkseSettingsStatus status = settings_check_signatures(&settings->catalog, storage_pex, pex_size, "StorageUtil",
        storage_keyword_signatures, 0, SKSE_STORAGE_KEYWORD_METHOD_LIMIT, methods);
    if (status == SKSE_SETTINGS_OK) {
        memcpy(settings->storage_keyword, methods, sizeof methods);
        settings->storage_keyword_id = form_id;
    }
    return status;
}

SkseSettingsStatus skse_classic_storage_invoke_keyword(SkseClassicSettings *settings, uint64_t epoch,
    SkseStorageKeywordMethod method, const SkseClassicFormSnapshot *keyword, const char *key, size_t key_size,
    uint32_t bits, uint32_t uptime_ms, SkseClassicScalarResult *output, uint64_t *ticket, SkseX86Result *trace) {
    if (trace) *trace = (SkseX86Result){.status = SKSE_X86_BAD_ARGUMENT};
    if (!settings || settings->epoch != epoch || settings->pending || !settings->storage_keyword_id ||
        (unsigned)method >= SKSE_STORAGE_KEYWORD_METHOD_LIMIT || !keyword || !key || key_size < 2 ||
        key_size > SKSE_CLASSIC_FRAME_STRING_BYTES || !output || !ticket ||
        keyword->type != LANTERN_KEYWORD_TYPE || keyword->id != settings->storage_keyword_id ||
        keyword->handle != (UINT64_C(0xffff00000000) | keyword->id)) return SKSE_SETTINGS_ARGUMENT;
    const SkseClassicScalar arguments[] = {{.type = SKSE_CLASSIC_CATALOG_FORM},
        {.type = 2, .text = key, .text_size = key_size}, {.type = 3, .bits = bits}};
    return settings_execute(settings, settings->storage_keyword[method], arguments, 3, uptime_ms, false,
                            NULL, keyword, output, ticket, trace);
}

enum { ClassicStorageWork = 250000 };

static SkseSettingsStatus storage_views(SkseClassicSettings *settings, uint64_t epoch,
    const SkseLoadedMod *mods, size_t count, uint8_t singleton[4], SkseX86ReadView views[4]) {
    enum { ViewBase = 0x14000000, EntryStart = 0xb00, EntrySize = 0x428 };
    if (!settings || settings->epoch != epoch || settings->pending || !mods ||
        !count || count > SKSE_CLASSIC_MOD_LIMIT) return SKSE_SETTINGS_ARGUMENT;
    if (settings->retired) return SKSE_SETTINGS_RETIRED;
    const SksePluginSession *session = &settings->session;
    if (session->result.status != SKSE_TRIAL_ENGINE_HOOKS_OBSERVED ||
        !session->vm.services.serialization || session->serial.uid != SKSE_CLASSIC_STORAGE_UID)
        return SKSE_SETTINGS_STARTUP;
    if (settings->storage_keyword_id) {
        const size_t owner = settings->storage_keyword_id >> 24;
        if (owner >= count || !lantern_owner(&mods[owner])) return SKSE_SETTINGS_ARGUMENT;
    }
    for (size_t i = 0; i < count; ++i) {
        const SkseLoadedMod *mod = &mods[i];
        if (mod->kind != SKSE_LOADED_CLASSIC || mod->index != i ||
            !mod->name || !mod->length || mod->length > SKSE_CLASSIC_MOD_NAME_LIMIT ||
            memchr(mod->name, '\0', mod->length)) return SKSE_SETTINGS_ARGUMENT;
    }

    const size_t size = EntryStart + EntrySize * count;
    uint8_t *catalog = calloc(1, size);
    if (!catalog) return SKSE_SETTINGS_MEMORY;
    write_word(singleton, ViewBase);
    write_word(catalog + CLASSIC_LOADED_COUNT, (uint32_t)count);
    /* DataHandler embeds the tList head. The remaining nodes occupy the
     * first 8 bytes of each entry, before the copied ModInfo names. */
    for (size_t i = 0; i < count; ++i) {
        const uint32_t offset = EntryStart + (uint32_t)i * EntrySize;
        const uint32_t object = ViewBase + offset + 8;
        uint8_t *entry = catalog + offset;
        uint8_t *node = i ? entry : catalog + CLASSIC_MOD_LIST;
        write_word(node, object);
        if (i + 1 < count) write_word(node + 4, ViewBase + offset + EntrySize);
        write_word(catalog + CLASSIC_LOADED_MODS + 4 * i, object);
        memcpy(entry + 8 + CLASSIC_FILE_NAME, mods[i].name, mods[i].length);
        entry[8 + CLASSIC_FILE_INDEX] = (uint8_t)i;
    }
    views[0] = settings->bootstrap_views[0];
    views[1] = settings->bootstrap_views[1];
    views[2] = (SkseX86ReadView){CLASSIC_DATA_HANDLER, singleton, 4};
    views[3] = (SkseX86ReadView){ViewBase, catalog, size};
    return SKSE_SETTINGS_OK;
}

static SkseSessionResult load_keyword_storage(SksePluginSession *session, uint32_t uptime_ms, uint32_t form_id) {
    enum { KeywordView = 0x14009000, LookupFormByID = 0x00451a30, CatalogViewCount = 4 };
    SkseX86Services *services = &session->vm.services;
    const SkseX86ReadView *prior_views = services->read_views;
    const size_t prior_services = services->count;
    if (services->read_view_count != CatalogViewCount || services->entries != session->entries ||
        prior_services >= SKSE_X86_MAX_SERVICES || services->classic_load_forms) return SKSE_SESSION_UNAVAILABLE;

    uint8_t body[SKSE_CLASSIC_FORM_VIEW_BYTES] = {0};
    write_word(body + 0x0c, form_id);
    body[0x12] = LANTERN_KEYWORD_TYPE;
    SkseX86ReadView views[CatalogViewCount + 1];
    memcpy(views, prior_views, CatalogViewCount * sizeof views[0]);
    views[CatalogViewCount] = (SkseX86ReadView){KeywordView, body, sizeof body};
    const SkseClassicLoadForm keyword = {form_id, KeywordView, LANTERN_KEYWORD_TYPE};
    const SkseClassicLoadForms forms = {.owner = 0, .forms = &keyword, .count = 1};
    services->read_views = views;
    services->read_view_count = CatalogViewCount + 1;
    services->classic_load_forms = &forms;
    session->entries[services->count++] = (SkseX86Service){LookupFormByID, 0, SKSE_X86_CLASSIC_LOOKUP_FORM};
    const SkseSessionResult result = session_serialization(session, SKSE_SERIAL_LOAD, ClassicStorageWork, uptime_ms);
    services->classic_load_forms = NULL;
    services->read_views = prior_views;
    services->read_view_count = CatalogViewCount;
    services->count = prior_services;
    return result;
}

static SkseSessionResult restore_storage(SksePluginSession *session, const SksePluginRecordSet *input,
                                         const SkseSerialResolvers *resolvers, uint32_t uptime_ms,
                                         uint32_t storage_keyword_id) {
    if (!session->serial.callbacks[SKSE_SERIAL_REVERT - SKSE_SERIAL_REVERT] ||
        !session->serial.callbacks[SKSE_SERIAL_LOAD - SKSE_SERIAL_REVERT]) return SKSE_SESSION_UNAVAILABLE;
    if (!skse_x86_records_copy(&session->serial.records, &input->records)) return SKSE_SESSION_NO_MEMORY;
    SkseSessionResult result = session_serialization(session, SKSE_SERIAL_REVERT, ClassicStorageWork, uptime_ms);
    if (result == SKSE_SESSION_OK) {
        session->serial.resolvers = resolvers;
        result = storage_keyword_id ? load_keyword_storage(session, uptime_ms, storage_keyword_id)
                                    : session_serialization(session, SKSE_SERIAL_LOAD, ClassicStorageWork, uptime_ms);
        session->serial.resolvers = NULL;
    }
    skse_x86_records_close(&session->serial.records);
    return result;
}

static SkseSettingsStatus storage_run(SkseClassicSettings *settings, uint64_t epoch,
    const SkseLoadedMod *mods, size_t count, uint32_t uptime_ms,
    const SksePluginRecordSet *input, const SkseSerialResolvers *resolvers, SksePluginRecordSet **out) {
    uint8_t singleton[4];
    SkseX86ReadView views[4];
    SkseSettingsStatus status = storage_views(settings, epoch, mods, count, singleton, views);
    if (status != SKSE_SETTINGS_OK) return status;

    SksePluginSession *session = &settings->session;
    SkseX86Services *services = &session->vm.services;
    const SkseX86ReadView *old_views = services->read_views;
    const size_t old_count = services->read_view_count;
    services->read_views = views;
    services->read_view_count = sizeof views / sizeof views[0];
    SkseSessionResult result = SKSE_SESSION_UNAVAILABLE;
    if (input) result = restore_storage(session, input, resolvers, uptime_ms, settings->storage_keyword_id);
    else if (!out) result = session_serialization(session, SKSE_SERIAL_REVERT, ClassicStorageWork, uptime_ms);
    else if (session->serial.callbacks[SKSE_SERIAL_SAVE - SKSE_SERIAL_REVERT])
        result = collect_session_records(session, ClassicStorageWork, uptime_ms, out);
    services->read_views = old_views;
    services->read_view_count = old_count;
    free((void *)views[3].bytes);
    if (result == SKSE_SESSION_NO_MEMORY) return SKSE_SETTINGS_MEMORY;
    return result == SKSE_SESSION_OK ? SKSE_SETTINGS_OK : settings_retire(settings, SKSE_SETTINGS_EXECUTION);
}

SkseSettingsStatus skse_classic_storage_capture(SkseClassicSettings *settings, uint64_t epoch,
    const SkseLoadedMod *mods, size_t count, uint32_t uptime_ms, SksePluginRecordSet **out) {
    if (!out || *out) return SKSE_SETTINGS_ARGUMENT;
    return storage_run(settings, epoch, mods, count, uptime_ms, NULL, NULL, out);
}

SkseSettingsStatus skse_classic_storage_reset(SkseClassicSettings *settings, uint64_t epoch,
    const SkseLoadedMod *mods, size_t count, uint32_t uptime_ms) {
    return storage_run(settings, epoch, mods, count, uptime_ms, NULL, NULL, NULL);
}

SkseSettingsStatus skse_classic_storage_restore(SkseClassicSettings *settings, uint64_t epoch,
    const SkseLoadedMod *mods, size_t count, uint32_t uptime_ms,
    const SksePluginRecordSet *input, const SkseSerialResolvers *resolvers) {
    if (skse_plugin_record_set_uid(input) != SKSE_CLASSIC_STORAGE_UID) return SKSE_SETTINGS_ARGUMENT;
    return storage_run(settings, epoch, mods, count, uptime_ms, input, resolvers, NULL);
}
