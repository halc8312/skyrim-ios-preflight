/* The x87 subset uses an explicit 64-bit significand. Host long double is
 * binary64 on Apple arm64 and cannot represent the Classic CRT's intermediates. */

typedef struct {
    uint64_t mantissa;
    int exponent;
    bool negative;
} Extended;

enum { EXTENDED_INFINITY = 16384, EXTENDED_MIN_EXPONENT = -16382 };

static Extended ext_from_integer(int64_t integer) {
    const bool negative = integer < 0;
    const uint64_t magnitude = negative ? -(uint64_t)integer : (uint64_t)integer;
    if (!magnitude) return (Extended){0};
    const unsigned normalize = (unsigned)__builtin_clzll(magnitude);
    return (Extended){magnitude << normalize, 63 - (int)normalize, negative};
}

static Extended ext_from_binary(uint64_t bits, unsigned width) {
    const unsigned fraction_bits = width == 4 ? 23 : 52;
    const unsigned maximum = width == 4 ? 255 : 2047, bias = maximum / 2;
    const unsigned exponent = (unsigned)(bits >> fraction_bits) & maximum;
    const uint64_t fraction = bits & ((UINT64_C(1) << fraction_bits) - 1);
    Extended value = {.negative = (bits >> (fraction_bits + (width == 4 ? 8 : 11))) != 0};
    if (!exponent && !fraction) return value;
    value.mantissa = fraction << (63 - fraction_bits);
    value.exponent = (int)exponent - (int)bias;
    if (exponent) {
        value.mantissa |= UINT64_C(1) << 63;
        if (exponent == maximum) {
            value.exponent = EXTENDED_INFINITY;
            if (fraction) value.mantissa |= UINT64_C(1) << 62;
        }
    } else {
        const unsigned normalization = (unsigned)__builtin_clzll(value.mantissa);
        value.mantissa <<= normalization;
        value.exponent += 1 - (int)normalization;
    }
    return value;
}

static uint64_t ext_to_binary(Extended value, unsigned width, uint16_t *status) {
    const unsigned fraction_bits = width == 4 ? 23 : 52;
    const unsigned maximum = width == 4 ? 255 : 2047;
    const int bias = (int)(maximum / 2);
    const uint64_t sign = value.negative ? UINT64_C(1) << (width * 8 - 1) : 0;
    const uint64_t infinity = (uint64_t)maximum << fraction_bits;
    const uint64_t significand_bit = UINT64_C(1) << 63;
    if (!value.mantissa) return sign;
    if (value.exponent == EXTENDED_INFINITY) {
        const uint64_t payload = (value.mantissa ^ significand_bit) >> (63 - fraction_bits);
        return sign | infinity | payload;
    }
    const int exponent = value.exponent + bias;
    if (exponent >= (int)maximum) {
        *status |= 0x28;                          /* overflow and inexact */
        return sign | infinity;
    }
    const int shift = 63 - (int)fraction_bits + (exponent > 0 ? 0 : 1 - exponent);
    if (shift > 64) {
        *status |= 0x30;                          /* underflow and inexact */
        return sign;
    }
    const uint64_t half = UINT64_C(1) << (shift - 1);
    const uint64_t remainder = value.mantissa & ((half << 1) - 1);
    uint64_t rounded = shift == 64 ? 0 : value.mantissa >> shift;
    if (remainder) *status |= 0x20;
    if (remainder > half || (remainder == half && (rounded & 1))) {
        ++rounded;
        *status |= 0x0200;                        /* rounded up */
    }
    const uint64_t biased = exponent > 0 ? (uint64_t)(exponent - 1) << fraction_bits : 0;
    const uint64_t magnitude = biased + rounded;
    if (magnitude == infinity) *status |= 0x28;
    if (exponent <= 0 && remainder && magnitude < (UINT64_C(1) << fraction_bits)) *status |= 0x10;
    return sign | magnitude;
}

static int ext_magnitude_compare(Extended left, Extended right) {
    if (!left.mantissa || !right.mantissa) return (left.mantissa != 0) - (right.mantissa != 0);
    if (left.exponent != right.exponent) return left.exponent < right.exponent ? -1 : 1;
    return (left.mantissa > right.mantissa) - (left.mantissa < right.mantissa);
}

static uint16_t ext_compare(Extended left, Extended right) {
    const uint64_t infinity = UINT64_C(1) << 63;
    if ((left.exponent == EXTENDED_INFINITY && left.mantissa != infinity) ||
        (right.exponent == EXTENDED_INFINITY && right.mantissa != infinity)) return 0x4500;
    if (!left.mantissa && !right.mantissa) return 0x4000;
    int cmp = ext_magnitude_compare(left, right);
    if (left.negative != right.negative) cmp = left.negative ? -1 : 1;
    else if (left.negative) cmp = -cmp;
    return cmp == 0 ? 0x4000 : cmp < 0 ? 0x0100 : 0;
}

static __uint128_t ext_shift_right(__uint128_t value, unsigned shift) {
    if (!shift) return value;
    if (shift >= 128) return value != 0;
    const __uint128_t discarded = value & (((__uint128_t)1 << shift) - 1);
    return (value >> shift) | (discarded != 0);
}

static bool ext_round(__uint128_t mantissa, int exponent, bool negative,
                      Extended *value, uint16_t *status) {
    const __uint128_t normal_bit = (__uint128_t)1 << 66;
    if (!mantissa) {
        *value = (Extended){0};
        return true;
    }
    while (mantissa < normal_bit) {
        mantissa <<= 1;
        --exponent;
    }
    if (mantissa >= normal_bit * 2) {
        mantissa = ext_shift_right(mantissa, 1);
        ++exponent;
    }
    const unsigned guard = (unsigned)mantissa & 7;
    uint64_t rounded = (uint64_t)(mantissa >> 3);
    if (guard) *status |= 0x20;
    if (guard > 4 || (guard == 4 && (rounded & 1))) {
        if (!++rounded) {
            rounded = UINT64_C(1) << 63;
            ++exponent;
        }
        *status |= 0x0200;
    }
    if (exponent < EXTENDED_MIN_EXPONENT || exponent >= EXTENDED_INFINITY) return false;
    *value = (Extended){rounded, exponent, negative};
    return true;
}

static bool ext_add(Extended left, Extended right, Extended *value, uint16_t *status) {
    if (left.exponent == EXTENDED_INFINITY || right.exponent == EXTENDED_INFINITY) return false;
    if (!left.mantissa && !right.mantissa) {
        *value = (Extended){.negative = left.negative && right.negative};
        return true;
    }
    if (!left.mantissa || !right.mantissa) {
        *value = left.mantissa ? left : right;
        return true;
    }
    if (ext_magnitude_compare(left, right) < 0) {
        const Extended saved = left;
        left = right;
        right = saved;
    }
    const __uint128_t a = (__uint128_t)left.mantissa << 3;
    const __uint128_t b = ext_shift_right((__uint128_t)right.mantissa << 3, (unsigned)(left.exponent - right.exponent));
    return ext_round(left.negative == right.negative ? a + b : a - b, left.exponent, left.negative, value, status);
}

static bool ext_multiply(Extended left, Extended right, Extended *value, uint16_t *status) {
    if (left.exponent == EXTENDED_INFINITY || right.exponent == EXTENDED_INFINITY) return false;
    const bool negative = left.negative != right.negative;
    if (!left.mantissa || !right.mantissa) {
        *value = (Extended){.negative = negative};
        return true;
    }
    const __uint128_t product = (__uint128_t)left.mantissa * right.mantissa;
    const bool carry = (product >> 127) != 0;
    return ext_round(ext_shift_right(product, 60 + carry), left.exponent + right.exponent + carry,
                     negative, value, status);
}

static bool ext_divide(Extended left, Extended right, Extended *value, uint16_t *status) {
    if (left.exponent == EXTENDED_INFINITY || right.exponent == EXTENDED_INFINITY || !right.mantissa)
        return false;
    const bool negative = left.negative != right.negative;
    if (!left.mantissa) {
        *value = (Extended){.negative = negative};
        return true;
    }
    const bool normalize = left.mantissa < right.mantissa;
    const __uint128_t numerator = (__uint128_t)left.mantissa << (63 + normalize);
    const uint64_t quotient = (uint64_t)(numerator / right.mantissa);
    const __uint128_t remainder = (numerator % right.mantissa) << 3;
    const unsigned guard = (unsigned)(remainder / right.mantissa) | (remainder % right.mantissa != 0);
    return ext_round((__uint128_t)quotient << 3 | guard, left.exponent - right.exponent - normalize,
                     negative, value, status);
}
