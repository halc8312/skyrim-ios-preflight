# Opt-in helper for a test build that already owns its private DXVK target.
# The checkout and original target properties other than this one source stay intact.
function(skyrim_trial_present_grade target dxvk generated)
  if(NOT TARGET "${target}")
    message(FATAL_ERROR "Create the pinned DXVK target before adding the presentation trial")
  endif()
  get_filename_component(dxvk "${dxvk}" REALPATH)
  get_filename_component(generated "${generated}" REALPATH)
  foreach(file IN ITEMS grade_host_blitter.cpp grade_dxvk_present_frag.h grade_dxvk_present_frag_blit.h
                        grade_dxvk_present_frag_ms.h grade_dxvk_present_frag_ms_amd.h)
    if(NOT EXISTS "${generated}/${file}")
      message(FATAL_ERROR "Prepare the display grade fixture first: missing ${file}")
    endif()
  endforeach()
  get_target_property(sources "${target}" SOURCES)
  get_target_property(start "${target}" SOURCE_DIR)
  set(found 0)
  set(out)
  foreach(source IN LISTS sources)
    get_filename_component(full "${source}" ABSOLUTE BASE_DIR "${start}")
    if(full STREQUAL "${dxvk}/src/dxvk/dxvk_swapchain_blitter.cpp")
      list(APPEND out "${generated}/grade_host_blitter.cpp")
      math(EXPR found "${found}+1")
    else()
      list(APPEND out "${source}")
    endif()
  endforeach()
  if(NOT found EQUAL 1)
    message(FATAL_ERROR "Expected exactly one pinned swapchain blitter in ${target}")
  endif()
  set_property(TARGET "${target}" PROPERTY SOURCES "${out}")
  target_include_directories("${target}" PRIVATE "${dxvk}/src/dxvk")
endfunction()
