* text=auto
*.sh text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.c text eol=lf
*.h text eol=lf
*.mm text eol=lf
*.metal text eol=lf
*.plist text eol=lf
*.pbxproj text eol=lf
*.xcscheme text eol=lf
# Preserve canonical patch hashes and unified-diff blank context, including at EOF.
*.patch text eol=lf whitespace=-blank-at-eol,-blank-at-eof
