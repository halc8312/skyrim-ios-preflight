// Only the adapter clock and platform QoS are authored. TLS get/set and the
// scope come from the production metrics C/header linked by the fixture.
static std::atomic<uint64_t> clockNs{1}, clockCalls{0};
extern "C" uint64_t skyrim_perf_now_ns(void) {
    const auto value=clockNs.fetch_add(10);
    clockCalls.fetch_add(1);
    return value;
}
extern "C" int skyrim_device_platform_work_role(unsigned) { return 0; }

namespace dxvk {
namespace env { static void setThreadName(const char*) {} }
/* ACTUAL_KEY */
static const DxvkShaderKey g_nullShaderKey;
class DxvkShader : public RcObject {
    DxvkShaderKey key;
public:
    explicit DxvkShader(const DxvkShaderKey& k):key(k){}
    DxvkShaderKey getShaderKey() const { return key; }
};
struct DxvkGraphicsPipelineShaders { Rc<DxvkShader> vs,tcs,tes,gs,fs; };
struct DxvkComputePipelineShaders { Rc<DxvkShader> cs; };
struct State { unsigned id; };
struct Format { unsigned id; };
struct DxvkStateCacheEntry { DxvkStateCacheKey shaders; State gpState,cpState; Format format; };
struct Pass { unsigned id; };
struct DxvkRenderPassPool {
    Pass pass[8]{};
    Pass* getRenderPass(Format f) { assert(f.id<8);pass[f.id].id=f.id;return &pass[f.id]; }
};
static DxvkStateCacheKey tuple(const DxvkGraphicsPipelineShaders& p) {
    DxvkStateCacheKey k;
    if(p.vs!=nullptr)k.vs=p.vs->getShaderKey();
    if(p.tcs!=nullptr)k.tcs=p.tcs->getShaderKey();
    if(p.tes!=nullptr)k.tes=p.tes->getShaderKey();
    if(p.gs!=nullptr)k.gs=p.gs->getShaderKey();
    if(p.fs!=nullptr)k.fs=p.fs->getShaderKey();
    return k;
}
static std::string identity(const DxvkStateCacheKey& k) {
    return k.vs.toString()+k.tcs.toString()+k.tes.toString()+k.gs.toString()+k.fs.toString()+k.cs.toString();
}
struct Ledger {
    size_t attempts=0;
    std::set<std::string> results,failures;
    std::vector<SkyrimPerfPrefetch> prefetch;
    std::function<void()> onCompile;
};
struct Pipeline {
    std::string key;Ledger* ledger;
    void compilePipeline(State state,Pass* pass=nullptr) {
        ++ledger->attempts;
        ledger->prefetch.push_back(skyrim_perf_prefetch_get());
        if(ledger->onCompile)ledger->onCompile();
        const std::string id=key+":"+std::to_string(state.id)+":"+std::to_string(pass?pass->id:99);
        ledger->results.insert(id);
        // Authored permanent failure represents the existing cached-null
        // pipeline behavior; it must not become a success by removing repeats.
        if(state.id==7)ledger->failures.insert(id);
    }
};
struct DxvkPipelineManager {
    Ledger ledger;
    std::shared_ptr<Pipeline> createGraphicsPipeline(const DxvkGraphicsPipelineShaders& p) {
        return std::make_shared<Pipeline>(Pipeline{identity(tuple(p)),&ledger});
    }
    std::shared_ptr<Pipeline> createComputePipeline(const DxvkComputePipelineShaders& p) {
        DxvkStateCacheKey key;key.cs=p.cs->getShaderKey();
        return std::make_shared<Pipeline>(Pipeline{identity(key),&ledger});
    }
};
class DxvkStateCache {
    /* ACTUAL_WORKER_ITEM */
    DxvkPipelineManager* m_pipeManager;DxvkRenderPassPool* m_passManager;
    std::vector<DxvkStateCacheEntry> m_entries;
    dxvk::mutex m_entryLock,m_workerLock;
    dxvk::condition_variable m_workerCond;
    std::unordered_multimap<DxvkStateCacheKey,size_t,DxvkHash,DxvkEq> m_entryMap;
    std::unordered_multimap<DxvkShaderKey,DxvkStateCacheKey,DxvkHash,DxvkEq> m_pipelineMap;
    std::unordered_map<DxvkShaderKey,Rc<DxvkShader>,DxvkHash,DxvkEq> m_shaderMap;
    std::queue<WorkerItem> m_workerQueue;
    std::atomic<bool> m_stopThreads{false};
    std::atomic<unsigned> m_workerBusy{1};
    size_t numShaderTuples = 0;
    DxvkShaderKey getShaderKey(const Rc<DxvkShader>& shader) const;
    bool getShaderByKey(const DxvkShaderKey& key,Rc<DxvkShader>& shader) const;
    void mapPipelineToEntry(const DxvkStateCacheKey& key,size_t entryId);
    void mapShaderToPipeline(const DxvkShaderKey& shader,const DxvkStateCacheKey& key);
    void compilePipelines(const WorkerItem& item);
public:
    DxvkStateCache(DxvkPipelineManager& p,DxvkRenderPassPool& r):m_pipeManager(&p),m_passManager(&r){}
    void load(const DxvkStateCacheEntry& entry) {
        /* ACTUAL_LOADING */
    }
    void registerShader(const Rc<DxvkShader>& shader);
    void workerFunc();
    void stop() {
        { std::lock_guard<dxvk::mutex> lock(m_workerLock); m_stopThreads=true; }
        m_workerCond.notify_all();
    }
    bool idle() const { return m_workerBusy.load()==0; }
    std::unique_lock<dxvk::mutex> holdWorker() { return std::unique_lock<dxvk::mutex>(m_workerLock); }
    bool entryHeld() {
        if(!m_entryLock.try_lock())return true;
        m_entryLock.unlock();return false;
    }
    size_t jobs() { std::lock_guard<dxvk::mutex> lock(m_workerLock);return m_workerQueue.size(); }
    size_t entries() const { assert(m_entryMap.size()==m_entries.size());return m_entries.size(); }
    size_t mappings() const { return m_pipelineMap.size(); }
    size_t tuples() const { return numShaderTuples; }
    void drain() {
        for(;;){WorkerItem item;
            {std::lock_guard<dxvk::mutex> lock(m_workerLock);if(m_workerQueue.empty())return;
             item=m_workerQueue.front();m_workerQueue.pop();}
            compilePipelines(item);
        }
    }
};
/* ACTUAL_METHODS */
static DxvkShaderKey key(unsigned stage,unsigned id) {
    return DxvkShaderKey(VkShaderStageFlagBits(1u<<stage),Sha1Hash::compute(id));
}
static void run(unsigned variants,bool concurrent,bool reverse) {
    DxvkPipelineManager manager;DxvkRenderPassPool passes;DxvkStateCache cache(manager,passes);
    std::vector<DxvkStateCacheKey> keys;
    // Shared VS across several distinct tuples; 6-stage availability; compute.
    for(unsigned group=0;group<6;++group){DxvkStateCacheKey k;
        if(group<3){k.vs=key(0,1);k.fs=key(4,group+10);}
        else if(group==3){k.vs=key(0,2);k.tcs=key(1,3);k.tes=key(2,4);k.gs=key(3,5);k.fs=key(4,6);}
        else k.cs=key(5,group+20);
        keys.push_back(k);
    }
    std::set<std::string> expected,failures;
    std::vector<Rc<DxvkShader>> shaders;
    std::set<std::string> registered;
    for(const auto& k:keys){
        for(const auto& s:{k.vs,k.tcs,k.tes,k.gs,k.fs,k.cs})
            if(!s.eq(g_nullShaderKey)&&registered.insert(s.toString()).second)shaders.push_back(new DxvkShader(s));
        for(unsigned n=0;n<variants;++n){unsigned id=reverse?variants-1-n:n;
            cache.load({k,{id},{id},{id%8}});
            auto item=identity(k)+":"+std::to_string(id)+":"+std::to_string(k.cs.eq(g_nullShaderKey)?id%8:99);
            expected.insert(item);if(id==7)failures.insert(item);
        }
    }
    assert(cache.entries()==6*variants);
    assert(cache.tuples()==(PATCHED?6u:0u));
    cache.registerShader(new DxvkShader(g_nullShaderKey));assert(cache.jobs()==0);
    // No key is complete with only the shared VS, and a worker drain is empty.
    cache.registerShader(shaders.front());cache.drain();assert(manager.ledger.attempts==0);
    if(reverse)std::reverse(shaders.begin()+1,shaders.end());
    if(concurrent){std::vector<std::thread> threads;
        for(size_t i=1;i<shaders.size();++i)threads.emplace_back([&,i]{cache.registerShader(shaders[i]);});
        for(auto& t:threads)t.join();
    }else for(size_t i=1;i<shaders.size();++i)cache.registerShader(shaders[i]);
    const size_t jobs=cache.jobs();
    assert(jobs==6*(PATCHED?1:variants));
    cache.drain();assert(manager.ledger.results==expected);assert(manager.ledger.failures==failures);
    assert(manager.ledger.attempts==6*variants*(PATCHED?1:variants));
    if(variants==16&&!reverse&&!concurrent)
        printf("variants=%u entries=%zu mappings=%zu jobs=%zu visits=%zu unique=%zu\n",variants,cache.entries(),cache.mappings(),jobs,manager.ledger.attempts,expected.size());
}

#if PATCHED
static bool same(SkyrimPerfPrefetch a,SkyrimPerfPrefetch b) {
    return a.ready_ns==b.ready_ns&&a.queued_ns==b.queued_ns&&a.worker_ns==b.worker_ns;
}
template<class F> static void await(F ready) {
    const auto deadline=std::chrono::steady_clock::now()+std::chrono::seconds(5);
    while(!ready()) {
        assert(std::chrono::steady_clock::now()<deadline);
        std::this_thread::yield();
    }
}
static void prefetchControls() {
    const SkyrimPerfPrefetch outer{11,22,33};
    skyrim_perf_prefetch_set(outer);
    {
        DxvkPipelineManager manager;DxvkRenderPassPool passes;DxvkStateCache cache(manager,passes);
        DxvkStateCacheKey graphics;graphics.vs=key(0,101);graphics.fs=key(4,102);
        DxvkStateCacheKey compute;compute.cs=key(5,103);
        for(unsigned n=0;n<3;++n)cache.load({graphics,{n},{n},{n}});
        for(unsigned n=0;n<2;++n)cache.load({compute,{n},{n},{n}});
        clockNs=100;clockCalls=0;
        cache.registerShader(new DxvkShader(g_nullShaderKey));
        assert(clockCalls==0&&cache.jobs()==0);
        cache.registerShader(new DxvkShader(graphics.vs));
        assert(clockCalls==1&&cache.jobs()==0); // Missing final prerequisite.
        cache.registerShader(new DxvkShader(graphics.vs));
        assert(clockCalls==1&&cache.jobs()==0); // Duplicate is not a new arrival.

        clockNs=1000;
        cache.registerShader(new DxvkShader(graphics.fs));
        assert(clockCalls==3&&cache.jobs()==1);
        cache.registerShader(new DxvkShader(graphics.fs));
        assert(clockCalls==4&&cache.jobs()==2); // Existing duplicate wakeup preserved.
        clockNs=1500;
        cache.registerShader(new DxvkShader(compute.cs));
        assert(clockCalls==6&&cache.jobs()==3);
        manager.ledger.onCompile=[&] {
            const auto current=skyrim_perf_prefetch_get();
            { SkyrimPerfPrefetchScope nested({7,8,9});assert(same(skyrim_perf_prefetch_get(),{7,8,9})); }
            assert(same(skyrim_perf_prefetch_get(),current));
            if(manager.ledger.attempts==3)clockNs=3000;
            if(manager.ledger.attempts==6)clockNs=4000;
            if(manager.ledger.attempts==8)cache.stop();
        };
        clockNs=2000;
        cache.workerFunc(); // Actual loop, actual compilePipelines for all variants.
        assert(clockCalls==9&&manager.ledger.prefetch.size()==8);
        for(unsigned n=0;n<3;++n)assert(same(manager.ledger.prefetch[n],{1000,1010,2000}));
        for(unsigned n=3;n<6;++n)assert(same(manager.ledger.prefetch[n],{0,1020,3000}));
        for(unsigned n=6;n<8;++n)assert(same(manager.ledger.prefetch[n],{1500,1510,4000}));
        assert(same(skyrim_perf_prefetch_get(),outer));
    }
    {
        // Two tuples become eligible at the same insertion. Block queue access
        // until later: neither ready timestamp may include that lock wait.
        DxvkPipelineManager manager;DxvkRenderPassPool passes;DxvkStateCache cache(manager,passes);
        DxvkStateCacheKey a;a.vs=key(0,111);a.fs=key(4,112);
        auto b=a;b.fs=key(4,113);
        cache.load({a,{0},{0},{0}});cache.load({b,{1},{1},{1}});
        cache.registerShader(new DxvkShader(a.fs));cache.registerShader(new DxvkShader(b.fs));
        auto held=cache.holdWorker();clockNs=500;clockCalls=0;
        std::thread registration([&]{cache.registerShader(new DxvkShader(a.vs));});
        await([&]{return clockCalls.load()==1;});
        assert(cache.entryHeld()); // Eligibility capture is inside entry exclusion.
        clockNs=900;held.unlock();registration.join();
        assert(clockCalls==3&&cache.jobs()==2);
        manager.ledger.onCompile=[&]{if(manager.ledger.attempts==2)cache.stop();};
        clockNs=1200;cache.workerFunc();
        assert(same(manager.ledger.prefetch[0],{500,900,1200}));
        assert(same(manager.ledger.prefetch[1],{500,910,1210}));
        assert(same(skyrim_perf_prefetch_get(),outer));
    }
    {
        // Idle waiting and shutdown never read the instrumentation clock.
        DxvkPipelineManager manager;DxvkRenderPassPool passes;DxvkStateCache cache(manager,passes);
        clockCalls=0;
        std::thread worker([&]{
            skyrim_perf_prefetch_set({44,55,66});cache.workerFunc();
            assert(same(skyrim_perf_prefetch_get(),{44,55,66}));
        });
        await([&]{return cache.idle();});cache.stop();worker.join();
        assert(clockCalls==0&&same(skyrim_perf_prefetch_get(),outer));
    }
    {
        // Upstream still propagates a compiler exception. The scoped job must
        // unwind without leaving its metadata on a reused caller thread.
        DxvkPipelineManager manager;DxvkRenderPassPool passes;DxvkStateCache cache(manager,passes);
        DxvkStateCacheKey k;k.cs=key(5,121);cache.load({k,{0},{0},{0}});
        cache.registerShader(new DxvkShader(k.cs));
        manager.ledger.onCompile=[] { throw std::runtime_error("authored compile failure"); };
        bool caught=false;try{cache.workerFunc();}catch(const std::runtime_error&){caught=true;}
        assert(caught&&same(skyrim_perf_prefetch_get(),outer));
    }
    {
        // Independent worker threads share neither the active job nor the
        // previous TLS value. The get/set implementation is production C.
        std::vector<std::thread> workers;
        for(unsigned n=0;n<2;++n)workers.emplace_back([n]{
            const SkyrimPerfPrefetch previous{50+n,60+n,70+n};
            skyrim_perf_prefetch_set(previous);
            DxvkPipelineManager manager;DxvkRenderPassPool passes;DxvkStateCache cache(manager,passes);
            DxvkStateCacheKey k;k.cs=key(5,130+n);cache.load({k,{0},{0},{0}});
            cache.registerShader(new DxvkShader(k.cs));
            manager.ledger.onCompile=[&]{
                const auto current=skyrim_perf_prefetch_get();
                assert(current.ready_ns&&current.ready_ns<current.queued_ns&&current.queued_ns<current.worker_ns);
                cache.stop();
            };
            cache.workerFunc();assert(same(skyrim_perf_prefetch_get(),previous));
        });
        for(auto& t:workers)t.join();
        assert(same(skyrim_perf_prefetch_get(),outer));
    }
    puts("prefetch_metadata_actual_worker=PASS cases=7");
}
#endif
}
int main(int argc,char** argv){
#if PATCHED
    if(argc==2&&std::string(argv[1])=="prefetch"){dxvk::prefetchControls();return 0;}
#else
    (void)argc;(void)argv;
#endif
    for(unsigned n:{1u,2u,16u,128u})for(bool concurrent:{false,true})for(bool reverse:{false,true})dxvk::run(n,concurrent,reverse);
    puts("all_states_and_failure_identity=PASS concurrent_registration=PASS empty_and_partial=PASS");
}
