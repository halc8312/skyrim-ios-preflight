+#[test]
+fn committing_one_guest_page_preserves_live_neighbours_within_16k() {
+    let s = space();
+    let base = map::VIRTUAL_4K_BASE;
+    let size = 4 * PAGE_4K;
+    s.alloc_virtual_fixed(base, size, false, protect::READWRITE).unwrap();
+
+    // Each page shares one potential 16 KiB Darwin host page with its peers.
+    // Committing a later 4 KiB page must not clear earlier committed pages.
+    for page in 0..4 {
+        let at = base + page * PAGE_4K;
+        s.alloc_virtual_fixed(at, PAGE_4K, true, protect::READWRITE).unwrap();
+        assert!(s.mem.read_vec(at, PAGE_4K).iter().all(|&b| b == 0));
+        s.mem.fill(at, PAGE_4K, (page + 1) as u8);
+        for previous in 0..=page {
+            assert!(
+                s.mem.read_vec(base + previous * PAGE_4K, PAGE_4K).iter().all(|&b| b == (previous + 1) as u8),
+                "commit of page {page} changed live page {previous}"
+            );
+        }
+    }
+}
+
+#[test]
+fn decommitting_one_guest_page_preserves_live_neighbours_within_16k() {
+    let s = space();
+    let base = map::VIRTUAL_4K_BASE;
+    s.alloc_virtual_fixed(base, 4 * PAGE_4K, true, protect::READWRITE).unwrap();
+    for page in 0..4 {
+        s.mem.fill(base + page * PAGE_4K, PAGE_4K, (page + 1) as u8);
+    }
+
+    for page in [1, 2, 0, 3] {
+        let at = base + page * PAGE_4K;
+        s.decommit_virtual(at, PAGE_4K).unwrap();
+        assert!(s.mem.read_vec(at, PAGE_4K).iter().all(|&b| b == 0), "decommit must zero immediately");
+        for other in (0..4).filter(|&p| p != page) {
+            assert!(
+                s.mem.read_vec(base + other * PAGE_4K, PAGE_4K).iter().all(|&b| b == (other + 1) as u8),
+                "decommit of page {page} changed live page {other}"
+            );
+        }
+        s.mem.fill(at, PAGE_4K, 0xA5); // A stray access after decommit stays mapped.
+        s.alloc_virtual_fixed(at, PAGE_4K, true, protect::READWRITE).unwrap();
+        assert!(s.mem.read_vec(at, PAGE_4K).iter().all(|&b| b == 0), "recommit must clear stray writes");
+        s.mem.fill(at, PAGE_4K, (page + 1) as u8);
+    }
+}
+
+#[test]
+fn releasing_one_guest_page_preserves_live_neighbours_within_16k() {
+    let s = space();
+    let base = map::VIRTUAL_4K_BASE;
+    // Separate allocations are needed so each 4 KiB page can be released.
+    for page in 0..4 {
+        let at = base + page * PAGE_4K;
+        s.alloc_virtual_fixed(at, PAGE_4K, true, protect::READWRITE).unwrap();
+        s.mem.fill(at, PAGE_4K, (page + 1) as u8);
+    }
+
+    for page in [2, 1, 3, 0] {
+        let at = base + page * PAGE_4K;
+        assert_eq!(s.release_virtual(at).unwrap(), PAGE_4K);
+        assert!(s.mem.read_vec(at, PAGE_4K).iter().all(|&b| b == 0), "release must zero immediately");
+        for other in (0..4).filter(|&p| p != page) {
+            assert!(
+                s.mem.read_vec(base + other * PAGE_4K, PAGE_4K).iter().all(|&b| b == (other + 1) as u8),
+                "release of page {page} changed live page {other}"
+            );
+        }
+        s.mem.fill(at, PAGE_4K, 0x5A);
+        s.alloc_virtual_fixed(at, PAGE_4K, true, protect::READWRITE).unwrap();
+        assert!(s.mem.read_vec(at, PAGE_4K).iter().all(|&b| b == 0), "recommit must clear stray writes");
+        s.mem.fill(at, PAGE_4K, (page + 1) as u8);
+    }
+}
