diff --git a/cpp/CMakeLists.txt b/cpp/CMakeLists.txt
index 4200565..d38f767 100644
--- a/cpp/CMakeLists.txt
+++ b/cpp/CMakeLists.txt
@@ -57,8 +57,14 @@ if(EMSCRIPTEN)
         -fno-delete-null-pointer-checks
     )
 else()
+    # The instruction set is selected for the target, including cross builds.
+    # Apple ARM64 uses the compiler's platform baseline; x86 flags are invalid there.
+    if(CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|amd64|AMD64)$")
+        target_compile_options(skyrim_guest PRIVATE -march=x86-64-v2)
+    elseif(NOT CMAKE_SYSTEM_PROCESSOR MATCHES "^(aarch64|arm64|ARM64)$")
+        message(FATAL_ERROR "Unsupported native guest target: ${CMAKE_SYSTEM_PROCESSOR}")
+    endif()
     target_compile_options(skyrim_guest PRIVATE
-        -march=x86-64-v2
         # Rust unwinds through these frames on thread termination.
         -fexceptions
         -funwind-tables
