* text=auto
*.sh text eol=lf
*.patch text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.swift text eol=lf
*.metal text eol=lf
*.rs text eol=lf
*.h text eol=lf
*.toml text eol=lf
Cargo.lock text eol=lf
# Preserve the frozen allowlisted public text bytes for the source SHA gate.
/ci/resident/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
